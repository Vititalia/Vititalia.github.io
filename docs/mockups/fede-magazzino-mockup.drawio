p06_b206" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E2E8F0;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="1150" width="640" height="224" as="geometry"/></mxCell><mxCell id="p06_b207" value="Il codice portainnesto è la chiave di raggruppamento di tutti e tre i riepiloghi. Un codice disattivato sparisce dai select di inserimento ma resta visibile nei report storici con il chip «inattivo»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=9;fontColor=#CBD5E1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="320" y="1388" width="920" height="44" as="geometry"/></mxCell><mxCell id="p06_b208" value="S-15 · Import Excel (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="1180" height="26" as="geometry"/></mxCell><mxCell id="p06_b209" value="Passi 1–4 con stepper · nessuna scrittura prima della conferma · errori per riga/colonna/valore/motivo, esportabili in CSV · avanti bloccato finché restano errori · campi obbligatori per tabella da §3.4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="84" y="930" width="1176" height="60" as="geometry"/></mxCell><mxCell id="p06_b210" value="S-16 · Anagrafica vite (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1340" y="900" width="1180" height="26" as="geometry"/></mxCell><mxCell id="p06_b211" value="Una riga per coppia varietà+clone · raggruppamento visivo per varietà · aggiunta in blocco · duplicati rifiutati lato client (manca il vincolo UNIQUE nel DB)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1344" y="930" width="1176" height="60" as="geometry"/></mxCell><mxCell id="p06_b212" value="S-17 · Anagrafica portainnesto (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="1750" width="1180" height="26" as="geometry"/></mxCell><mxCell id="p06_b213" value="Solo codice · coppie usate non cancellabili, solo disattivabili · il codice è la chiave di raggruppamento dei riepiloghi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="84" y="1780" width="1176" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram>
