12;fontColor=#334155;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="630" y="764" width="190" height="30" as="geometry"/></mxCell><mxCell id="p00_b88" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=12;fontColor=#334155;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="820" y="764" width="190" height="30" as="geometry"/></mxCell><mxCell id="p00_b89" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=12;fontColor=#334155;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1010" y="764" width="190" height="30" as="geometry"/></mxCell><mxCell id="p00_b90" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E2E8F0;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1160" height="364" as="geometry"/></mxCell><mxCell id="p00_b91" value="Strategia responsive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=15;fontColor=#0F172A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="900" height="22" as="geometry"/></mxCell><mxCell id="p00_b92" value="Stesso insieme di dati, tre presentazioni. I riepiloghi sono responsive; l&#x27;inserimento dati è solo da PC." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="1200" height="20" as="geometry"/></mxCell><mxCell id="p00_b93" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="550" height="210" as="geometry"/></mxCell><mxCell id="p00_b94" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="550" height="34" as="geometry"/></mxCell><mxCell id="p00_b95" value="xs · 320–639 · smartphone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54" y="900" width="520" height="34" as="geometry"/></mxCell><mxCell id="p00_b96" value="Raggruppamento per portainnesto: una card per gruppo, una riga per clone, striscia di 4 metriche. Sottototali nell&#x27;intestazione della card. Nessuno scorrimento orizzontale." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="54" y="942" width="522" height="120" as="geometry"/></mxCell><mxCell id="p00_b97" value="S-04 · S-06 · S-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#64748B;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54" y="1074" width="150" height="22" as="geometry"/></mxCell><mxCell id="p00_b98" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="900" width="550" height="210" as="geometry"/></mxCell><mxCell id="p00_b99" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="900" width="550" height="34" as="geometry"/></mxCell><mxCell id="p00_b100" value="sm/md · 640–1023 · tablet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="624" y="900" width="520" height="34" as="geometry"/></mxCell><mxCell id="p00_b101" value="Stessa struttura a gruppi, elenco chiave/valore a due colonne, barra filtri su due righe. Le card diventano tabelle a partire da 1024 dp." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="624" y="942" width="522" height="120" as="geometry"/></mxCell><mxCell id="p00_b102" value="S-04 · S-05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#64748B;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="624" y="1074" width="150" height="22" as="geometry"/></mxCell><mxCell id="p00_b103" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="900" width="550" height="210" as="geometry"/></mxCell><mxCell id="p00_b104" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="900" width="550" height="34" as="geometry"/></mxCell><mxCell id="p00_b105" value="md/lg+ · ≥1024 · PC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1194" y="900" width="520" height="34" as="geometry"/></mxCell><mxCell id="p00_b106" value="Griglia dati vera: intestazione fissa, numeri allineati a destra, righe di subtotale evidenziate, righe negative in rosso grassetto. Solo qui l&#x27;inserimento dati." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1194" y="942" width="522" height="120" as="geometry"/></mxCell><mxCell id="p00_b107" value="S-05 · S-07 · S-13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#64748B;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1194" y="1074" width="150" height="22" as="geometry"/></mxCell><mxCell id="p00_b108" value="Principi di progetto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=15;fontColor=#0F172A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="900" height="22" as="geometry"/></mxCell><mxCell id="p00_b109" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#E2E8F0;strokeWidth=1;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1166" width="1660" height="74" as="geometry"/></mxCell><mxCell id="p00_b110" value="1. Il numero è l&#x27;interfaccia.   2. Il rosso significa solo sovra-impegnato.   3. Un subtotale è una promessa: «Totale portainnesto» sempre in grassetto su fondo tinto.   4. Prima filtra, poi leggi.   5. Un telefono non finge di essere una postazione: l&#x27;editing è negato, non approssimato.   6. L&#x27;anagrafica è l&#x27;unico vocabolario: mai testo libero per varietà, clone, portainnesto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="1176" width="1628" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram>
