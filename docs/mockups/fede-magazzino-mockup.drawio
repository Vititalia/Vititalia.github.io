="1"><mxGeometry x="320" y="1422" width="1240" height="34" as="geometry"/></mxCell><mxCell id="p04_b370" value="S-05 · Riepilogo disponibilità (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="1180" height="26" as="geometry"/></mxCell><mxCell id="p04_b371" value="Filtri in alto (Tipologia, Produzione, varietà ricercabile) · raggruppamento clone/portainnesto · ordinamento per portainnesto · riga «Totale portainnesto» in grassetto su fondo tinto · rossa l&#x27;intera riga con disponibilità negativa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="84" y="930" width="1176" height="60" as="geometry"/></mxCell><mxCell id="p04_b372" value="S-09 · Indisponibilità (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1340" y="900" width="1180" height="26" as="geometry"/></mxCell><mxCell id="p04_b373" value="Solo deficit · ordinamento varietà → portainnesto → clone · colonna Deficit in grassetto rosso · export identico alla vista" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1344" y="930" width="1176" height="60" as="geometry"/></mxCell><mxCell id="p04_b374" value="S-07 · Riepilogo per produttore (PC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1E6B4F;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="1770" width="1500" height="26" as="geometry"/></mxCell><mxCell id="p04_b375" value="Le stesse quantità divise nelle 8 colonne dei produttori · sottototali per portainnesto su tutte le colonne · visibile solo ad Amministratore e Amministrazione" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="84" y="1800" width="1496" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram>
